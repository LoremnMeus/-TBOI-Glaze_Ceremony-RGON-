	<!-- Parameters:
		id - id of the abyssed item
		damageMultiplier - dmg multiplier for the locust
		speed - movement speed of the locust
		collisionInterval - rate of the damage ticks
		tearFlags - tear flags for the locust
		color - color of the locust (chosen from the list previously created in the file)
		scale - size of the locust's hitbox
		gfx - specifies a custom sprite of the locust
		count - amount of locusts spawned at once from the abyssed item
		tearFlags2 - chance based tear flags for the locust
		procChance - determined chance for tearFlags2
		overlayGfx - places an additional sprite on top of the locust
		overlayColor - color of overlayGfx
		backGfx - places an additional sprite behind the locust
		backColor - color of backGfx
	-->
	
